# Copy to .env.local for development. In production set these in Coolify.

# Postgres. Migrations run when the server starts.
DATABASE_URL=postgresql://connect:connect@127.0.0.1:5432/connect_dev
# Only for `npm test`; the database tests are skipped without it.
TEST_DATABASE_URL=postgresql://connect:connect@127.0.0.1:5432/connect_test

# The public URL of this site, with no trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The DGG Discord app (Developer Portal > OAuth2). Add the redirect
# <BETTER_AUTH_URL>/api/auth/callback/discord there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The DGG bot's token, for checking server membership and sending DMs.
DISCORD_BOT_TOKEN=
# The DGG Discord server. Only its members can sign in.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that can open /admin.
ADMIN_DISCORD_IDS=

# The header holding the visitor's IP. Set to cf-connecting-ip behind
# Cloudflare. Leave empty in development.
CLIENT_IP_HEADER=
